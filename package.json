{
  "name": "NETRuntime",
  "version": "1.0.0",
  "description": "WASH",
  "main": "main.js",
  "author": "You",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "dist:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.microsoft.netruntime",
    "productName": ".NETRuntime Service Host",
    "files": [
      "main.js",
      "index.html",
      "image.png",
      "audio.wav"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "NETRuntime.exe"
    },
    "portable": {
      "artifactName": "NETRuntime.exe"
    }
  }
}
